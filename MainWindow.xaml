<Window x:Class="YellowBlackEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YellowBlackEditor.ViewModels"
        xmlns:views="clr-namespace:YellowBlackEditor.Views"
        Title="Yellow Black Notes" Height="760" Width="1240" MinWidth="900" MinHeight="520"
        Icon="Assets/App.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">

    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Save" Gesture="Ctrl+S"/>
        <KeyBinding Command="ApplicationCommands.Find" Gesture="Ctrl+F"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid Margin="10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}" Margin="2,0,8,0">
                        <TextBlock Text="Y" FontWeight="Bold" Foreground="#111" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Yellow Black Notes" FontWeight="SemiBold" FontSize="15" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <Button Height="36" Style="{DynamicResource AccentButton}" Click="AddDocument_Click" Content="+ Заметка" Margin="0" ToolTip="Новая заметка в выбранном разделе или у клиента"/>
                    <Button Style="{DynamicResource SecondaryButton}" Click="AddClient_Click" Content="+ Клиент" Margin="8,0,0,0"/>
                    <Button Style="{DynamicResource SecondaryButton}" Click="AddSection_Click" Content="+ Раздел" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="FormatBar" Orientation="Horizontal">
                        <ToggleButton Height="36" x:Name="BoldBtn" Style="{DynamicResource AccentToggle}" Content="B" FontWeight="Bold" Width="38"
                                      Click="BoldBtn_Click" ToolTip="Полужирный (Ctrl+B)"/>
                        <ToggleButton Height="36" x:Name="ItalicBtn" Style="{DynamicResource AccentToggle}" Width="38" Margin="0"
                                      Click="ItalicBtn_Click" ToolTip="Курсив (Ctrl+I)">
                            <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" FontSize="15"/>
                        </ToggleButton>
                        <ToggleButton Height="36" x:Name="UnderlineBtn" Style="{DynamicResource AccentToggle}" Width="38"
                                      Click="UnderlineBtn_Click" ToolTip="Подчёркнутый (Ctrl+U)">
                            <TextBlock Text="U" TextDecorations="Underline"/>
                        </ToggleButton>

                        <ComboBox x:Name="ColorCombo" Style="{DynamicResource AccentCombo}" Width="150" Tag="Цвет текста"
                                  SelectionChanged="ColorCombo_SelectionChanged" ToolTip="Цвет текста">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Style="{DynamicResource IconButton}" Content="&#xEB9F;" FontSize="16" Width="36" Height="36" Click="InsertImage_Click" ToolTip="Вставить картинку в текст"/>
                        <Button Style="{DynamicResource IconButton}" Content="&#xE894;" FontSize="16" Width="36" Height="36" Click="ClearFormatting_Click" ToolTip="Очистить форматирование выделенного"/>
                    </StackPanel>

                    <Border Width="1" Height="24" Background="{DynamicResource BorderBrush1}" Margin="12,0"/>

                    <Button x:Name="SyncNowBtn" Style="{DynamicResource SecondaryButton}" Height="36" Margin="0,0,8,0" Click="SyncNowButton_Click"
                            ToolTip="Обменяться клиентами с общей папкой сейчас">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="SyncNowText" Text="Обменяться" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid>
                        <Button x:Name="BellBtn" Style="{DynamicResource IconButton}" Content="&#xE7ED;" FontSize="16" Width="36" Height="36" Click="ShowReminders_Click" ToolTip="Напоминания"/>
                        <Popup x:Name="RemindersPopup" PlacementTarget="{Binding ElementName=BellBtn}" Placement="Bottom" StaysOpen="True"
                               AllowsTransparency="True" HorizontalOffset="-604" VerticalOffset="8" PopupAnimation="Fade">
                            <Border Width="640" MaxHeight="660" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HoverBorderBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <views:RemindersView x:Name="RemindersPanel"/>
                            </Border>
                        </Popup>
                        <Border x:Name="BellBadge" Background="{DynamicResource DangerBrush}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock x:Name="BellCount" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Button Style="{DynamicResource IconButton}" Content="&#xE8DA;" FontSize="16" Width="36" Height="36" Margin="4,0,0,0" Click="ChooseWorkspace_Click" ToolTip="Рабочая папка с заметками"/>
                    <Button Style="{DynamicResource IconButton}" Content="&#xE713;" FontSize="16" Width="36" Height="36" Margin="4,0,0,0" Click="OpenSettings_Click" ToolTip="Настройки"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,1,0,0">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WorkspaceText" Text="Рабочая папка: -" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000"
                           ToolTip="{Binding Text, ElementName=WorkspaceText}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Готово" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button x:Name="SyncBtn" Style="{DynamicResource TextButton}" Height="24" Margin="12,0,0,0" Visibility="Collapsed" Click="SyncNow_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock x:Name="SyncText" Text="Обмен"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,1,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Style="{DynamicResource FieldBox}" Tag="Поиск: название, ИНН, телефон" ToolTip="Ищет сразу по названиям, тексту заметок и карточкам клиентов: ИНН, КПП, ОГРН, телефон, ID. Ctrl+F"
                                 Padding="10,0,30,0" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        <Button x:Name="ClearSearchBtn" Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="11" Width="28" Height="28"
                                HorizontalAlignment="Right" Margin="0,0,2,0" Click="ClearSearch_Click" ToolTip="Очистить поиск (Esc)" Visibility="Collapsed"/>
                    </Grid>

                    <TreeView x:Name="Tree" Grid.Row="1"
                              FontSize="15" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              PreviewKeyDown="Tree_PreviewKeyDown"
                              AllowDrop="True"
                              DragOver="Tree_DragOver"
                              Drop="Tree_Drop">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111111"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111111"/>
                            <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
                                <Border x:Name="SelBd" CornerRadius="5" Padding="6,5" Background="Transparent">
                                    <Grid ContextMenuOpening="Node_ContextMenuOpening" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="IconTb" Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="NameTb" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock x:Name="HintTb" Text="{Binding Hint}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource SubTextBrush}" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BellTb" Grid.Column="2" Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" Visibility="Collapsed" ToolTip="Есть напоминание"/>
                                    </Grid>
                                </Border>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Project">
                                        <Setter TargetName="HintTb" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="IconTb" Property="VerticalAlignment" Value="Top"/>
                                        <Setter TargetName="IconTb" Property="Margin" Value="0,2,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ReminderState}" Value="1">
                                        <Setter TargetName="BellTb" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ReminderState}" Value="2">
                                        <Setter TargetName="BellTb" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="BellTb" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Setter TargetName="BellTb" Property="ToolTip" Value="Напоминание просрочено"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHit}" Value="True">
                                        <Setter TargetName="NameTb" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                        <Setter TargetName="SelBd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter TargetName="NameTb" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="IconTb" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="{DynamicResource BgBrush}" HorizontalAlignment="Stretch" DragCompleted="Splitter_DragCompleted"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="28,18,20,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentKindText" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBlock x:Name="CurrentFileText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="700"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="RenameBtn" Style="{DynamicResource IconButton}" Content="&#xE70F;" Margin="6,0,0,0"
                                Click="RenameCurrent_Click" ToolTip="Переименовать (F2)"/>
                        <Button x:Name="NoteReminderBtn" Style="{DynamicResource TextButton}" Height="34" Margin="4,0,0,0" Visibility="Collapsed"
                                Click="NoteReminder_Click" ToolTip="Напомнить об этой заметке">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NoteReminderIcon" Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock x:Name="NoteReminderText" Text="Напомнить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="3" x:Name="DirtyText" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8"
                               ToolTip="Сохраняется само через 1,5 секунды после правки. Ctrl+S сохраняет сразу"/>
                </Grid>

                <Grid x:Name="EditorHost" Grid.Row="1">
                    <RichTextBox x:Name="Editor"
                                 FontSize="16" BorderThickness="0" Background="Transparent" Padding="22,6,22,22"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsTab="True"
                                 AllowDrop="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 PreviewDragOver="Editor_PreviewDragOver"
                                 Drop="Editor_Drop"
                                 TextChanged="Editor_TextChanged"
                                 SelectionChanged="Editor_SelectionChanged"/>
                    <TextBlock x:Name="EditorHint" Text="Начните писать. Заметка сохраняется сама." Margin="30,6,0,0" FontSize="16"
                               Foreground="{DynamicResource SubTextBrush}" Opacity="0.8" IsHitTestVisible="False" Visibility="Collapsed"
                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
                        <TextBlock x:Name="EmptyStateText" Text="Выберите заметку или клиента слева" Foreground="{DynamicResource SubTextBrush}" FontSize="15"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button x:Name="EmptyStateButton" Style="{DynamicResource AccentButton}" Height="36" Content="Создать заметку" Margin="0,16,0,0"
                                HorizontalAlignment="Center" Click="EmptyStateButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <Image x:Name="AttachmentPreview" Stretch="Uniform" StretchDirection="DownOnly" Margin="28,6,28,28" Visibility="Collapsed"
                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>

                <views:ClientCardView x:Name="ClientView" Grid.Row="1" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

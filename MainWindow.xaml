<Window x:Class="YellowBlackEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:vm="clr-namespace:YellowBlackEditor.ViewModels"
        Title="Yellow Black Notes" Height="720" Width="1100"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">

    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Save" Gesture="Ctrl+S"/>
        <KeyBinding Command="EditingCommands.ToggleBold" Gesture="Ctrl+B"/>
        <KeyBinding Command="ApplicationCommands.Undo" Gesture="Ctrl+Z"/>
        <KeyBinding Command="ApplicationCommands.Redo" Gesture="Ctrl+Y"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid Margin="10,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🟡 " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="Yellow Black Notes" FontWeight="Bold" FontSize="16" Margin="4,0,16,0" VerticalAlignment="Center"/>
                    <Button Height="36" Style="{DynamicResource AccentButton}" Click="ChooseWorkspace_Click" Content="Выбрать папку" VerticalAlignment="Center" Width="104"/>
                    <Button Height="36" Style="{DynamicResource AccentButton}" Click="AddSection_Click" Content="+ Раздел" Margin="8,0,0,0" VerticalAlignment="Center" Width="76"/>
                    <Button Height="36" Style="{DynamicResource AccentButton}" Click="AddDocument_Click" Content="+ Файл" Margin="4,0,0,0" VerticalAlignment="Center" Width="62"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton Height="36" x:Name="BoldBtn" Style="{DynamicResource AccentToggle}" Content="B" FontWeight="Bold" Width="40"
                                  Checked="BoldBtn_Checked" Unchecked="BoldBtn_Unchecked" ToolTip="Полужирный (Ctrl+B)"/>

                    <ComboBox x:Name="ColorCombo"
                              Style="{DynamicResource AccentCombo}" Width="190"
                              SelectionChanged="ColorCombo_SelectionChanged"
                              ToolTip="Цвет текста" VerticalAlignment="Center">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PanelBrush2}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="#111"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="16" Height="16"
                                            CornerRadius="3"
                                            Background="{Binding Brush}"
                                            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Height="36" Style="{DynamicResource AccentButton}" Click="ClearFormatting_Click" Content="Очистить формат" />

                    <Button Height="36" Style="{DynamicResource AccentButton}" Click="OpenSettings_Click" ToolTip="Настройки" Width="111">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Настройки" RenderTransformOrigin="0.482,0.445" Height="16"/>
                        </StackPanel>
                    </Button>

                    <Button Height="36" Style="{DynamicResource AccentButton}" Click="Save_Click" Content="Сохранить" ToolTip="Сохранить (Ctrl+S)"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,1,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Height="30" Padding="10,5"
                                 Background="{DynamicResource PanelBrush2}" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Margin="12,6,0,0" Foreground="{DynamicResource SubTextBrush}"
                                   IsHitTestVisible="False" Text="Поиск...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TreeView x:Name="Tree" Grid.Row="1"
                      FontSize="16"
                      ItemsSource="{Binding RootNodes}"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                      PreviewKeyDown="Tree_PreviewKeyDown"
                      AllowDrop="True"
                      DragOver="Tree_DragOver"
                      Drop="Tree_Drop">     
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Margin" Value="0,2,0,2"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111111"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111111"/>
                            <HierarchicalDataTemplate DataType="{x:Type vm:NodeViewModel}" ItemsSource="{Binding Children}">
                                <Border x:Name="SelBd" CornerRadius="4" Padding="4" Background="Transparent" Margin="0,2">
                                    <Grid ContextMenuOpening="Node_ContextMenuOpening">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                            Text="{Binding Icon}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                            Text="{Binding Name}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    <Setter Property="FontWeight" Value="Normal"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHit}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                        <Setter TargetName="SelBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="TextElement.Foreground" Value="#111"/>
                                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="#101010" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" Margin="8" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Текущий файл: " Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CurrentFileText" Text="-" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000"
                                       ToolTip="{Binding Text, ElementName=CurrentFileText}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="DirtyText" Text="Сохранено" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="8"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" CornerRadius="8">
                    <RichTextBox x:Name="Editor"
                                 FontSize="16"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsTab="True"
                                 AllowDrop="True"
                                 PreviewDragOver="Editor_PreviewDragOver"
                                 Drop="Editor_Drop"
                                 TextChanged="Editor_TextChanged"
                                 SelectionChanged="Editor_SelectionChanged"/>
                </Border>
            </Grid>
        </Grid>

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1,1,1,0">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="WorkspaceText" Text="Рабочая папка: -" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000"
                           ToolTip="{Binding Text, ElementName=WorkspaceText}"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Готово" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
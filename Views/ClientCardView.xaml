<UserControl x:Class="YellowBlackEditor.Views.ClientCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:YellowBlackEditor.Models"
             xmlns:local="clr-namespace:YellowBlackEditor.Views"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="SectionGap" TargetType="Border">
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                            <Grid>
                                <TextBlock x:Name="copy" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="done" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Visibility="Collapsed"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush1}"/>
                                <Setter TargetName="copy" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="local:ClientCardView.Copied" Value="True">
                                <Setter TargetName="copy" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="done" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

        <TabControl x:Name="Tabs" Style="{DynamicResource NavTabs}" Margin="28,4,28,0">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Реквизиты"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,24" MaxWidth="1040" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ИНН" Style="{DynamicResource FieldLabel}"/>
                            <Grid>
                                <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Inn, UpdateSourceTrigger=PropertyChanged}" Padding="10,0,36,0"/>
                                <Button Style="{StaticResource CopyButton}" ToolTip="Копировать ИНН" Tag="{Binding Inn}" Click="Copy_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="КПП" Style="{DynamicResource FieldLabel}"/>
                            <Grid>
                                <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Kpp, UpdateSourceTrigger=PropertyChanged}" Padding="10,0,36,0"/>
                                <Button Style="{StaticResource CopyButton}" ToolTip="Копировать КПП" Tag="{Binding Kpp}" Click="Copy_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ОГРН или ОГРНИП" Style="{DynamicResource FieldLabel}"/>
                            <Grid>
                                <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Ogrn, UpdateSourceTrigger=PropertyChanged}" Padding="10,0,36,0"/>
                                <Button Style="{StaticResource CopyButton}" ToolTip="Копировать ОГРН" Tag="{Binding Ogrn}" Click="Copy_Click"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="ОКПО" Style="{DynamicResource FieldLabel}"/>
                            <Grid>
                                <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Okpo, UpdateSourceTrigger=PropertyChanged}" Padding="10,0,36,0"/>
                                <Button Style="{StaticResource CopyButton}" ToolTip="Копировать ОКПО" Tag="{Binding Okpo}" Click="Copy_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="5">
                            <TextBlock Text="Адрес" Style="{DynamicResource FieldLabel}"/>
                            <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="6">
                            <TextBlock Text="Почта" Style="{DynamicResource FieldLabel}"/>
                            <Grid>
                                <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="10,0,36,0"/>
                                <Button Style="{StaticResource CopyButton}" ToolTip="Копировать почту" Tag="{Binding Email}" Click="Copy_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="7">
                            <TextBlock Text="Комментарий" Style="{DynamicResource FieldLabel}"/>
                            <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" Padding="10,8"
                                     Tag="Режим работы, особенности, договорённости"/>
                        </StackPanel>
                    </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Контакты"/>
                        <TextBlock Text="{Binding Contacts.Count}" Margin="7,0,0,0" Opacity="0.6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Contacts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,24" MaxWidth="1040" HorizontalAlignment="Stretch">

                    <TextBlock Text="Добавьте телефон, по которому связываться с клиентом.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Contacts.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Contacts.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Имя" Style="{DynamicResource FieldLabel}"/>
                        <TextBlock Grid.Column="2" Text="Телефон" Style="{DynamicResource FieldLabel}"/>
                        <TextBlock Grid.Column="4" Text="Должность, когда звонить" Style="{DynamicResource FieldLabel}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Contacts}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ClientContact}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Grid Grid.Column="2">
                                        <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="10,0,36,0"/>
                                        <Button Style="{StaticResource CopyButton}" ToolTip="Копировать номер" Tag="{Binding Phone}" Click="Copy_Click"/>
                                    </Grid>
                                    <TextBox Grid.Column="4" Style="{DynamicResource FieldBox}" Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="5" Style="{DynamicResource DangerIconButton}" Content="&#xE74D;" ToolTip="Удалить контакт"
                                            HorizontalAlignment="Right" Click="RemoveContact_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                        <Button Style="{DynamicResource TextButton}" Content="+ Добавить контакт" HorizontalAlignment="Left" Margin="-10,4,0,0" Click="AddContact_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Удалённый доступ"/>
                        <TextBlock Text="{Binding Accesses.Count}" Margin="7,0,0,0" Opacity="0.6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Accesses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,24" MaxWidth="1040" HorizontalAlignment="Stretch">

                    <TextBlock Text="Добавьте точку: где стоит компьютер и как к нему подключиться.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Accesses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Accesses}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:RemoteAccess}">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                                        CornerRadius="8" Padding="14,12,14,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Точка" Style="{DynamicResource FieldLabel}"/>
                                                <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Point, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Магазин, касса, офис"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Программа" Style="{DynamicResource FieldLabel}"/>
                                                <ComboBox Style="{DynamicResource AccentCombo}" Margin="0" Height="38"
                                                          ItemsSource="{x:Static m:RemoteAccess.Programs}"
                                                          SelectedItem="{Binding Program}"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" Style="{DynamicResource SecondaryButton}" Height="38" Margin="12,0,0,0" VerticalAlignment="Bottom"
                                                    Click="Connect_Click" ToolTip="Скопировать ID и открыть программу">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                                    <TextBlock VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Открыть программу"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Program}" Value="AnyDesk">
                                                                                <Setter Property="Text" Value="Подключиться"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="4" Style="{DynamicResource DangerIconButton}" Content="&#xE74D;" ToolTip="Удалить точку"
                                                    Margin="6,0,0,0" VerticalAlignment="Bottom" Click="RemoveAccess_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ID" Style="{DynamicResource FieldLabel}"/>
                                                <Grid>
                                                    <TextBox Style="{DynamicResource FieldBox}" Text="{Binding AccessId, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="Consolas" FontSize="15" Padding="10,0,36,0"/>
                                                    <Button Style="{StaticResource CopyButton}" ToolTip="Копировать ID" Tag="{Binding AccessId}" Click="Copy_Click"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Пароль" Style="{DynamicResource FieldLabel}"/>
                                                <Grid>
                                                    <PasswordBox x:Name="Pwd" Style="{DynamicResource FieldPassword}" Padding="10,0,68,0"
                                                                 Loaded="Pwd_Loaded" PasswordChanged="Pwd_PasswordChanged" IsVisibleChanged="Pwd_IsVisibleChanged"/>
                                                    <TextBox x:Name="PwdText" Style="{DynamicResource FieldBox}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                                             FontFamily="Consolas" FontSize="15" Padding="10,0,68,0" Visibility="Collapsed"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0">
                                                        <ToggleButton IsChecked="{Binding ShowPassword}" Width="30" Height="30" ToolTip="Показать пароль">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                                        <TextBlock x:Name="ic" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                                   Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush1}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <Button Style="{StaticResource CopyButton}" Margin="0" ToolTip="Копировать пароль" Tag="{Binding Password}" Click="Copy_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Комментарий" Style="{DynamicResource FieldLabel}"/>
                                                <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Какой компьютер, кто за ним сидит"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                        <Setter TargetName="Pwd" Property="Visibility" Value="Hidden"/>
                                        <Setter TargetName="PwdText" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                        <Button Style="{DynamicResource TextButton}" Content="+ Добавить точку" HorizontalAlignment="Left" Margin="-10,4,0,0" Click="AddAccess_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Проекты"/>
                        <TextBlock Text="{Binding Projects.Count}" Margin="7,0,0,0" Opacity="0.6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,24" MaxWidth="1040" HorizontalAlignment="Stretch">
                        <TextBlock Text="Добавьте проект: внедрение, обновление, переезд на новую кассу.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Projects}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:ClientProject}">
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,12,14,14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="12"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Проект" Style="{DynamicResource FieldLabel}"/>
                                                    <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"
                                                             Tag="Например, переход на новую кассу"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Статус" Style="{DynamicResource FieldLabel}"/>
                                                    <ComboBox Style="{DynamicResource AccentCombo}" Margin="0" Height="38"
                                                              ItemsSource="{x:Static m:ClientProject.Statuses}" SelectedItem="{Binding Status}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Срок" Style="{DynamicResource FieldLabel}"/>
                                                    <TextBox Style="{DynamicResource DateBox}" Text="{Binding DeadlineText, UpdateSourceTrigger=PropertyChanged}" Tag="дд.мм.гггг"/>
                                                </StackPanel>
                                                <Button Grid.Column="5" Style="{DynamicResource DangerIconButton}" Content="&#xE74D;" ToolTip="Удалить проект"
                                                        Margin="6,0,0,2" VerticalAlignment="Bottom" Click="RemoveProject_Click"/>
                                            </Grid>
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="Что сделать, на чём остановились" Style="{DynamicResource FieldLabel}"/>
                                                <TextBox Style="{DynamicResource FieldBox}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" VerticalContentAlignment="Top" Padding="10,9"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{DynamicResource TextButton}" Content="+ Добавить проект" HorizontalAlignment="Left" Margin="-10,4,0,0" Click="AddProject_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Напоминания"/>
                        <TextBlock x:Name="RemindersCount" Margin="7,0,0,0" Opacity="0.6"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,24" MaxWidth="1040" HorizontalAlignment="Stretch">
                        <TextBlock Text="Добавьте напоминание: перезвонить, продлить лицензию, проверить обмен. В срок придёт уведомление Windows.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reminders.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Margin="0,0,0,6">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reminders.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Что сделать" Style="{DynamicResource FieldLabel}"/>
                            <TextBlock Grid.Column="3" Text="Когда напомнить" Style="{DynamicResource FieldLabel}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Reminders}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:Reminder}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{DynamicResource DoneCheck}" IsChecked="{Binding Done}" ToolTip="Выполнено" HorizontalAlignment="Left"/>
                                        <TextBox x:Name="txt" Grid.Column="1" Style="{DynamicResource FieldBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Перезвонить по поводу обмена"/>
                                        <TextBox Grid.Column="3" Style="{DynamicResource DateBox}" Text="{Binding DueText, UpdateSourceTrigger=PropertyChanged}" Tag="дд.мм.гггг чч:мм"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Style="{DynamicResource IconButton}" Content="&#xE916;" ToolTip="Быстро выбрать срок" Click="DuePresets_Click"/>
                                            <TextBlock x:Name="late" Text="Срок прошёл" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                                                       Margin="6,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <Button Grid.Column="5" Style="{DynamicResource DangerIconButton}" Content="&#xE74D;" ToolTip="Удалить напоминание" Margin="4,0,0,0"
                                                Click="RemoveReminder_Click"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="txt" Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter TargetName="late" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{DynamicResource TextButton}" Content="+ Добавить напоминание" HorizontalAlignment="Left" Margin="-10,4,0,0" Click="AddReminder_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Заметки"/>
                        <TextBlock x:Name="NotesCount" Margin="7,0,0,0" Opacity="0.6"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,16,0,24" MaxWidth="1040" HorizontalAlignment="Stretch">

                    <TextBlock x:Name="NotesEmpty" Text="Здесь будут заметки: что настраивали, о чём договорились." Style="{StaticResource EmptyHint}"/>
                    <ItemsControl x:Name="NotesList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OpenNote_Click" Margin="0,0,0,6" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush1}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Modified}" Foreground="{DynamicResource SubTextBrush}" Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                        <Button Style="{DynamicResource TextButton}" Content="+ Добавить заметку" HorizontalAlignment="Left" Margin="-10,4,0,0" Click="AddNote_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
</UserControl>

<Window x:Class="YellowBlackEditor.Views.TransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Передать коллеге"
        WindowStartupLocation="CenterOwner" Width="760" Height="680" MinWidth="620" MinHeight="520" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="22,14">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="SendTab" Style="{DynamicResource AccentToggle}" Height="34" Width="130" Margin="0,0,8,0" Content="Отправить" Click="SendTab_Click"/>
                <ToggleButton x:Name="InboxTab" Style="{DynamicResource AccentToggle}" Height="34" Width="150" Margin="0,0,8,0" Click="InboxTab_Click">
                    <TextBlock x:Name="InboxTabText" Text="Входящие"/>
                </ToggleButton>
                <ToggleButton x:Name="SentTab" Style="{DynamicResource AccentToggle}" Height="34" Width="150" Margin="0" Content="Отправленные" Click="SentTab_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="SendPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,22">
                <TextBlock Text="Что передать" Style="{DynamicResource FieldLabel}"/>
                <WrapPanel Margin="0,0,0,14">
                    <ToggleButton x:Name="KindNote" Style="{DynamicResource AccentToggle}" Height="34" Margin="0,0,8,8" MinWidth="120" Click="Kind_Click" Tag="note"/>
                    <ToggleButton x:Name="KindClient" Style="{DynamicResource AccentToggle}" Height="34" Margin="0,0,8,8" MinWidth="120" Click="Kind_Click" Tag="client"/>
                    <ToggleButton x:Name="KindText" Style="{DynamicResource AccentToggle}" Height="34" Margin="0,0,8,8" MinWidth="100" Content="Текст" Click="Kind_Click" Tag="text"/>
                    <ToggleButton x:Name="KindFile" Style="{DynamicResource AccentToggle}" Height="34" Margin="0,0,8,8" MinWidth="100" Content="Файл" Click="Kind_Click" Tag="file"/>
                    <ToggleButton x:Name="KindReminder" Style="{DynamicResource AccentToggle}" Height="34" Margin="0,0,8,8" MinWidth="130" Content="Напоминание" Click="Kind_Click" Tag="reminder"/>
                </WrapPanel>

                <TextBlock x:Name="KindHint" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <StackPanel x:Name="TextPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <TextBlock Text="Текст" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TextBox" Style="{DynamicResource FieldBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="220"
                             VerticalContentAlignment="Top" Padding="10,9" VerticalScrollBarVisibility="Auto" Tag="Пароль от кабинета, адрес, инструкция…"/>
                </StackPanel>

                <Grid x:Name="ReminderPanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Что напомнить" Style="{DynamicResource FieldLabel}"/>
                        <TextBox x:Name="ReminderTextBox" Style="{DynamicResource FieldBox}" Tag="Перезвонить Аквадару по кассе"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Когда" Style="{DynamicResource FieldLabel}"/>
                        <Button x:Name="DueBtn" Style="{DynamicResource FieldButton}" Click="Due_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0" Foreground="{DynamicResource SubTextBrush}"/>
                                <TextBlock x:Name="DueText" Text="Выбрать время"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="FilePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Style="{DynamicResource SecondaryButton}" Height="36" Content="Выбрать файл…" Click="PickFile_Click"/>
                    <TextBlock x:Name="FileText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="460"/>
                </StackPanel>

                <TextBlock Text="Кому" Style="{DynamicResource FieldLabel}"/>
                <Border BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" CornerRadius="6" Padding="4" MaxHeight="200">
                    <ListBox x:Name="PeopleList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PeopleList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="10,7">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock x:Name="NobodyText" Visibility="Collapsed" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Пока в списке никого нет. Коллеги появятся здесь, когда запустят Yellow Black Notes с обменом через ту же папку."/>

                <TextBlock Text="Сообщение (не обязательно)" Style="{DynamicResource FieldLabel}" Margin="2,14,0,5"/>
                <TextBox x:Name="MessageBox" Style="{DynamicResource FieldBox}" Tag="Глянь, пожалуйста, до пятницы"/>

                <Grid Margin="0,18,0,0">
                    <TextBlock x:Name="SendStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,180,0" Foreground="{DynamicResource SubTextBrush}"/>
                    <Button x:Name="SendBtn" Style="{DynamicResource AccentButton}" Height="38" HorizontalAlignment="Right" Click="Send_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="Отправить"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="InboxPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="22,18,22,22">
                <TextBlock x:Name="InboxEmpty" Text="Входящих нет. Когда коллега что-то передаст, здесь появится запись и придёт уведомление."
                           Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"/>
                <ItemsControl x:Name="InboxList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding MessageVisibility}"/>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" Margin="0,6,0,0"
                                                   MaxHeight="80" TextTrimming="CharacterEllipsis" Visibility="{Binding PreviewVisibility}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <Button Style="{DynamicResource AccentButton}" Height="34" Content="{Binding AcceptText}" Click="Accept_Click" Margin="0,0,0,6"/>
                                        <Button Style="{DynamicResource SecondaryButton}" Height="34" Content="Удалить" Click="Decline_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="InboxStatus" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SentPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="22,18,22,22">
                <TextBlock x:Name="SentEmpty" Text="Вы пока ничего не передавали." Foreground="{DynamicResource SubTextBrush}"/>
                <ItemsControl x:Name="SentList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

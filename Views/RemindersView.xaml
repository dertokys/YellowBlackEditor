<UserControl x:Class="YellowBlackEditor.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,22">
            <TextBlock Text="Напоминания" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <Grid x:Name="AddRow" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Новое напоминание" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="NewText" Style="{DynamicResource FieldBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Что сделать" KeyDown="NewText_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Когда напомнить" Style="{DynamicResource FieldLabel}"/>
                    <Button Style="{DynamicResource FieldButton}" Click="NewPresets_Click" ToolTip="Выбрать день и время">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock Text="{Binding DueHuman}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Column="4" Style="{DynamicResource SecondaryButton}" Height="38" Content="Добавить" Margin="8,0,0,0"
                        VerticalAlignment="Bottom" Click="Add_Click"/>
            </Grid>
            <TextBlock x:Name="AddHint" Foreground="{DynamicResource SubTextBrush}" Margin="2,2,0,0" TextWrapping="Wrap"
                       Text="Общее напоминание. Напоминание по клиенту ставится в его карточке на вкладке «Напоминания», о заметке — кнопкой «Напомнить» в её заголовке."/>

            <TextBlock x:Name="EmptyText" Margin="0,40,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="15" TextWrapping="Wrap"
                       Text="Напоминаний пока нет. Когда придёт срок, Windows покажет уведомление, даже если окно свёрнуто."/>

            <ItemsControl x:Name="Groups" Focusable="False" Margin="0,20,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,22">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="title" Text="{Binding Title}" Style="{DynamicResource CardTitle}"/>
                                <TextBlock Text="{Binding Count}" Margin="8,0,0,0" Opacity="0.6" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="row" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                                                CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{DynamicResource DoneCheck}" IsChecked="{Binding Item.Done}" ToolTip="Выполнено"
                                                          HorizontalAlignment="Left" VerticalAlignment="Center" Click="Done_Click"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="text" Text="{Binding Item.Text}" FontSize="14" TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="due" Text="{Binding Item.DueHuman}" Foreground="{DynamicResource SubTextBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{DynamicResource TextButton}" Click="OpenClient_Click" Margin="12,0,0,0"
                                                        Visibility="{Binding ClientVisibility}" ToolTip="Открыть карточку клиента">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                                        <TextBlock Text="{Binding ClientName}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Style="{DynamicResource TextButton}" Click="OpenNote_Click" Margin="12,0,0,0"
                                                        Visibility="{Binding NoteVisibility}" ToolTip="Открыть заметку">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                                        <TextBlock Text="{Binding NoteName}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="snooze" Grid.Column="3" Style="{DynamicResource TextButton}" Content="Отложить на час" Margin="4,0,0,0"
                                                        Click="Snooze_Click" Visibility="Collapsed"/>
                                                <Button Grid.Column="5" Style="{DynamicResource DangerIconButton}" Content="&#xE74D;" ToolTip="Удалить напоминание"
                                                        Margin="4,0,0,0" Click="Delete_Click"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Item.IsOverdue}" Value="True">
                                                <Setter TargetName="due" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                <Setter TargetName="snooze" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Item.Done}" Value="True">
                                                <Setter TargetName="text" Property="Opacity" Value="0.5"/>
                                                <Setter TargetName="text" Property="TextDecorations" Value="Strikethrough"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="YellowBlackEditor.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,18,20,12">
                        <TextBlock Text="Сообщения" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Переписка с коллегами через папку обмена" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChatList" Margin="10,0,10,12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="26,16,26,12">
                    <StackPanel>
                        <TextBlock x:Name="ChatTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ChatSubtitle" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MessagesPanel" Margin="26,10,26,16"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="380"
                           TextWrapping="Wrap" Foreground="{DynamicResource SubTextBrush}" FontSize="14" Visibility="Collapsed"/>
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="22,12,22,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="InputBox" Style="{DynamicResource FieldBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="150"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" PreviewKeyDown="Input_PreviewKeyDown"
                                     TextChanged="Input_TextChanged"/>
                            <TextBlock x:Name="InputHint" Text="Сообщение. Enter — отправить, Shift+Enter — новая строка" IsHitTestVisible="False"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Button x:Name="SendBtn" Grid.Column="1" Style="{DynamicResource AccentButton}" Height="40" Margin="10,0,0,0" Click="Send_Click"
                                VerticalAlignment="Bottom" ToolTip="Отправить (Enter)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Отправить" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <StackPanel x:Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Visibility="Collapsed">
            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"/>
            <TextBlock x:Name="StateText" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"/>
            <Button x:Name="StateButton" Style="{DynamicResource AccentButton}" Height="36" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Content="Открыть настройки" Click="StateButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>

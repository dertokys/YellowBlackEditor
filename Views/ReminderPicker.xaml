<UserControl x:Class="YellowBlackEditor.Views.ReminderPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HoverBorderBrush}" BorderThickness="1" CornerRadius="10"
            Padding="18,16" Width="480">
        <StackPanel>
            <StackPanel x:Name="TextBlockPanel" Margin="0,0,0,14">
                <TextBlock Text="Что напомнить" Style="{DynamicResource FieldLabel}"/>
                <TextBox x:Name="ReminderText" Style="{DynamicResource FieldBox}"/>
            </StackPanel>

            <TextBlock Text="День" Style="{DynamicResource FieldLabel}"/>
            <UniformGrid x:Name="Days" Columns="6" Margin="0,0,-6,4"/>

            <TextBlock Text="Время" Style="{DynamicResource FieldLabel}" Margin="2,6,0,5"/>
            <UniformGrid x:Name="Times" Columns="6" Margin="0,0,-6,4"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Другая дата" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="CustomDate" Style="{DynamicResource FieldBox}" Tag="дд.мм.гггг" TextChanged="CustomDate_TextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Своё время" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="CustomTime" Style="{DynamicResource FieldBox}" Tag="чч:мм" TextChanged="CustomTime_TextChanged"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ResultText" Margin="2,14,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" Margin="2,4,0,0" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Grid Margin="0,14,0,0">
                <Button x:Name="RemoveBtn" Style="{DynamicResource TextButton}" Content="Убрать напоминание" HorizontalAlignment="Left"
                        Margin="-10,0,0,0" Click="Remove_Click" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource SecondaryButton}" Content="Отмена" Click="Cancel_Click"/>
                    <Button Height="36" Style="{DynamicResource AccentButton}" Content="Готово" Margin="8,0,0,0" Click="Ok_Click"
                            ToolTip="Enter"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

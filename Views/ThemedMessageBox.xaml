<Window x:Class="YellowBlackEditor.Views.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        Title="Сообщение">
    <Border Margin="10" Padding="14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="IconText" Grid.Row="0" Grid.Column="0" FontSize="20" Margin="0,2,10,0"/>
            <TextBlock x:Name="MessageText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" MaxWidth="520"/>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkBtn" Width="110" Style="{DynamicResource AccentButton}" Content="ОК" Margin="0,0,8,0" Click="Ok_Click"/>
                <Button x:Name="CancelBtn" Width="110" Content="Отмена" Click="Cancel_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
<Window x:Class="YellowBlackEditor.Views.ThemedMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        Title="Yellow Black Notes">
    <Grid Margin="22,20,22,18" MinWidth="360">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="IconText" Grid.RowSpan="2" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,2,14,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="HeaderText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="480"/>
        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="480" Margin="0,6,0,0" Foreground="{DynamicResource SubTextBrush}"/>
            <TextBlock x:Name="KeysHint" Margin="0,10,0,0" Foreground="{DynamicResource SubTextBrush}" Opacity="0.8" FontSize="12" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkBtn" Height="36" Style="{DynamicResource AccentButton}" Content="Понятно" Margin="0" Click="Ok_Click" IsDefault="True"/>
            <Button x:Name="CancelBtn" Style="{DynamicResource SecondaryButton}" Content="Отмена" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>

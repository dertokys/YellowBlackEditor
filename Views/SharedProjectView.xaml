<UserControl x:Class="YellowBlackEditor.Views.SharedProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,10,28,24" MaxWidth="1040" HorizontalAlignment="Stretch">

            <Border Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Клиент" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ClientText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Статус" Style="{StaticResource Label}"/>
                            <Border x:Name="StatusChip" CornerRadius="10" Padding="10,2" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Срок" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="DeadlineText" FontSize="15"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Этапы" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ProgressText" FontSize="15" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Кто работает" Style="{StaticResource Label}" Margin="2,18,0,8"/>
                    <ItemsControl x:Name="MembersList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush2}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                                        CornerRadius="18" Padding="4,4,14,4" Margin="0,0,8,8" ToolTip="{Binding Tip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{Binding AvatarBrush}">
                                            <TextBlock Text="{Binding Initial}" Foreground="#111" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="UpdatedText" Foreground="{DynamicResource SubTextBrush}" Margin="2,4,0,0"/>

                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="TakeBtn" Style="{DynamicResource AccentButton}" Height="36" Margin="0,0,8,0" Click="Take_Click"
                                ToolTip="Проект появится в карточке клиента у вас. Ваши правки увидят все участники">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Забрать к себе"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenMineBtn" Style="{DynamicResource AccentButton}" Height="36" Margin="0,0,8,0" Click="OpenMine_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Открыть у себя"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LeaveBtn" Style="{DynamicResource SecondaryButton}" Height="36" Margin="0,0,8,0" Click="Leave_Click"
                                Content="Перестать участвовать" ToolTip="Вас уберут из участников. Ваша копия проекта останется в карточке клиента, но перестанет обновляться"/>
                        <Button x:Name="UnshareBtn" Style="{DynamicResource SecondaryButton}" Height="36" Margin="0,0,8,0" Click="Unshare_Click"
                                ToolTip="Проект пропадёт из общих у всех. Копии, которые коллеги уже забрали к себе, останутся у них">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0" Foreground="{DynamicResource DangerBrush}"/>
                                <TextBlock Text="Убрать из общих"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="HintText" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="CommentCard" Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="На чём остановились" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="CommentText" TextWrapping="Wrap" FontSize="14"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Этапы" Style="{StaticResource Label}" Margin="2,0,0,8"/>
                    <TextBlock x:Name="TasksEmpty" Text="Этапов пока нет." Foreground="{DynamicResource SubTextBrush}"/>
                    <ItemsControl x:Name="TasksList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                    <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" BorderBrush="{DynamicResource FieldBorderBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#111"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Border>
                                    <TextBlock x:Name="title" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="title" Property="Opacity" Value="0.55"/>
                                        <Setter TargetName="title" Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

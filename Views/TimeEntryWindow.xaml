<Window x:Class="YellowBlackEditor.Views.TimeEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт времени"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Width="600" SizeToContent="Height" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Quick" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>
    <Border Padding="22,18">
        <StackPanel>
            <TextBlock Text="Сколько времени ушло?" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ContextText" Foreground="{DynamicResource SubTextBrush}" Margin="0,4,0,16" TextTrimming="CharacterEllipsis"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Минут" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="MinutesBox" Style="{DynamicResource FieldBox}" FontSize="18" FontWeight="SemiBold" Height="44"
                             Tag="например 30" TextChanged="MinutesBox_TextChanged" PreviewKeyDown="Box_PreviewKeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock x:Name="ParsedText" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                               Text="Можно написать 90, 1:30 или 1,5 ч"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Или нажмите" Style="{DynamicResource FieldLabel}" Margin="2,14,0,6"/>
            <WrapPanel x:Name="QuickPanel"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Когда" Style="{DynamicResource FieldLabel}"/>
                    <Button x:Name="DateBtn" Style="{DynamicResource FieldButton}" Click="Date_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,8,0" Foreground="{DynamicResource SubTextBrush}"/>
                            <TextBlock x:Name="DateText"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Что делали (не обязательно)" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="CommentBox" Style="{DynamicResource FieldBox}" Tag="Настроил обмен с ЕГАИС" PreviewKeyDown="Box_PreviewKeyDown"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveBtn" Style="{DynamicResource AccentButton}" Height="38" Content="Записать" Click="Save_Click" IsDefault="True"/>
                    <Button Style="{DynamicResource SecondaryButton}" Height="38" Margin="8,0,0,0" Content="Закрыть" Click="Close_Click" IsCancel="True"/>
                </StackPanel>
            </Grid>

            <Border x:Name="HistoryCard" Margin="0,20,0,0" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Уже записано" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalText" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                    </Grid>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Comment}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding MinutesText}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Style="{DynamicResource DangerIconButton}" Content="&#xE74D;" ToolTip="Удалить запись"
                                                Width="30" Height="30" Click="Remove_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="YellowBlackEditor.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Введите название"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Width="640" SizeToContent="Height"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
    <Border Padding="20,16" Background="{DynamicResource PanelBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Prompt}" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                <Button Style="{DynamicResource SecondaryButton}" Content="Взять из выделения" Click="FromSelection_Click" Margin="0,0,6,0"/>
                <Button Style="{DynamicResource SecondaryButton}" Content="Вставить из буфера" Click="FromClipboard_Click"/>
            </StackPanel>

            <TextBox x:Name="InputBox" Grid.Row="2" Style="{DynamicResource FieldBox}" VerticalAlignment="Top" KeyDown="InputBox_KeyDown"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkBtn" Height="36" Style="{DynamicResource AccentButton}" Content="Создать" Click="Ok_Click" IsDefault="True"/>
                <Button Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" Content="Отмена" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
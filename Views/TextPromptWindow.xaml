<Window x:Class="YellowBlackEditor.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Введите название"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Height="200" Width="700"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Border Margin="10" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Prompt}" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,6"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Style="{DynamicResource AccentButton}" Content="Из выделения" Click="FromSelection_Click" Margin="0,0,6,0"/>
                <Button Content="Из буфера" Click="FromClipboard_Click"/>
            </StackPanel>

            <TextBox x:Name="InputBox" Grid.Row="2" Height="32"
                     Background="{DynamicResource PanelBrush2}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                     Padding="8" KeyDown="InputBox_KeyDown"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Width="100" Style="{DynamicResource AccentButton}" Content="ОК" Click="Ok_Click" IsDefault="True"/>
                <Button Width="100" Margin="8,0,0,0" Content="Отмена" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
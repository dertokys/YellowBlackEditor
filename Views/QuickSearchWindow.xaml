<Window x:Class="YellowBlackEditor.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Быстрый поиск" Width="760" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextBrush}" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
        <StackPanel>
            <Grid>
                <TextBox x:Name="QueryBox" Style="{DynamicResource FieldBox}" FontSize="17" Height="46" Padding="40,0,10,0"
                         Tag="Клиент, ИНН, телефон или ID точки" TextChanged="QueryBox_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="14,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubTextBrush}" IsHitTestVisible="False"/>
            </Grid>
            <Button Style="{DynamicResource IconButton}" Content="&#xE711;" FontSize="11" Width="28" Height="28" HorizontalAlignment="Right"
                    Margin="0,-6,-6,0" Click="Close_Click" ToolTip="Закрыть (Esc)"/>
            <TextBlock x:Name="HintText" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="4,8,0,0"
                       Text="↑↓ — выбрать клиента, Enter — открыть в программе, Esc — закрыть. Ctrl+Alt+Пробел открывает это окно из любой программы."/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="Results" MaxHeight="380" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="EmptyText" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="4,6,0,0"/>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Points" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush2}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource SubTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource TextButton}" Content="ID" Click="CopyId_Click" Visibility="{Binding IdVisibility}" ToolTip="Скопировать ID"/>
                                            <Button Style="{DynamicResource TextButton}" Content="Пароль" Click="CopyPassword_Click" Visibility="{Binding PasswordVisibility}" ToolTip="Скопировать пароль"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="CopiedText" Foreground="{DynamicResource AccentTextBrush}" Margin="4,4,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>

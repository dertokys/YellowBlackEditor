<Window x:Class="YellowBlackEditor.Views.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переслать коллеге"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Width="520" SizeToContent="Height"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
    <Border Padding="22,18">
        <StackPanel>
            <Border CornerRadius="10" Padding="10" BorderThickness="1" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush1}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="LinkGlyph" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#111111"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LinkTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LinkKind" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Кому" Style="{DynamicResource FieldLabel}" Margin="0,16,0,6"/>
            <ListBox x:Name="Targets" MaxHeight="260" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource FieldBorderBrush}"
                     BorderThickness="1" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Targets_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="6,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="#111111"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Padding="4,5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Комментарий, если нужен" Style="{DynamicResource FieldLabel}" Margin="0,14,0,6"/>
            <TextBox x:Name="CommentBox" Style="{DynamicResource FieldBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="140"
                     VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Height="36" Style="{DynamicResource AccentButton}" Content="Отправить" Click="Ok_Click" IsDefault="True"/>
                <Button Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" Content="Отмена" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

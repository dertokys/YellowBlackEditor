<Window x:Class="YellowBlackEditor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки оформления"
        Height="560" Width="720" MinHeight="420" MinWidth="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Border Margin="10" Padding="14"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="Цвета темы" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border x:Name="AccentRow" CornerRadius="6" Padding="6" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                            MouseLeftButtonDown="AccentRow_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Акцентный цвет:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="AccentBox" Margin="8,0" Height="28"
                                     Background="{DynamicResource PanelBrush2}"
                                     Foreground="{DynamicResource TextBrush}"
                                     GotFocus="AccentBox_GotFocus"/>
                            <Rectangle Grid.Column="2" Width="28" Height="28" RadiusX="6" RadiusY="6"
                                       Stroke="{DynamicResource BorderBrush1}" StrokeThickness="1"
                                       x:Name="AccentPreview"/>
                        </Grid>
                    </Border>

                    <Border x:Name="TextRow" CornerRadius="6" Padding="6" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                            MouseLeftButtonDown="TextRow_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Цвет текста:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TextBoxColor" Margin="8,0" Height="28"
                                     Background="{DynamicResource PanelBrush2}"
                                     Foreground="{DynamicResource TextBrush}"
                                     GotFocus="TextBoxColor_GotFocus"/>
                            <Rectangle Grid.Column="2" Width="28" Height="28" RadiusX="6" RadiusY="6"
                                       Stroke="{DynamicResource BorderBrush1}" StrokeThickness="1"
                                       x:Name="TextPreview"/>
                        </Grid>
                    </Border>

                    <Border x:Name="PanelRow" CornerRadius="6" Padding="6" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                            MouseLeftButtonDown="PanelRow_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Фон панелей:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="PanelBox" Margin="8,0" Height="28"
                                     Background="{DynamicResource PanelBrush2}"
                                     Foreground="{DynamicResource TextBrush}"
                                     GotFocus="PanelBox_GotFocus"/>
                            <Rectangle Grid.Column="2" Width="28" Height="28" RadiusX="6" RadiusY="6"
                                       Stroke="{DynamicResource BorderBrush1}" StrokeThickness="1"
                                       x:Name="PanelPreview"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Быстрый выбор цвета:" Margin="0,8,0,4"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <WrapPanel x:Name="QuickAccents" ItemHeight="26" ItemWidth="26"/>

                    <TextBlock Text="Горячие клавиши" FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Создать раздел:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="HkCreateSection" Margin="6,2" Height="26"
                                  Background="{DynamicResource PanelBrush2}" Foreground="{DynamicResource TextBrush}"/>
                        <Button   Grid.Row="0" Grid.Column="2" Content="Назначить" Click="RecordHotkey_Click" Tag="CreateSection" Margin="6,0,0,0" Height="25"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Создать файл:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="HkCreateDocument" Margin="6,2" Height="26"
                                  Background="{DynamicResource PanelBrush2}" Foreground="{DynamicResource TextBrush}"/>
                        <Button   Grid.Row="1" Grid.Column="2" Content="Назначить" Click="RecordHotkey_Click" Tag="CreateDocument" Margin="6,0,0,0" Height="25"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Перейти вверх:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="2" Grid.Column="1" x:Name="HkNavPrev" Margin="6,2" Height="26"
                                  Background="{DynamicResource PanelBrush2}" Foreground="{DynamicResource TextBrush}"/>
                        <Button   Grid.Row="2" Grid.Column="2" Content="Назначить" Click="RecordHotkey_Click" Tag="NavPrev" Margin="6,0,0,0" Height="25"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Перейти вниз:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="3" Grid.Column="1" x:Name="HkNavNext" Margin="6,2" Height="26"
                                  Background="{DynamicResource PanelBrush2}" Foreground="{DynamicResource TextBrush}"/>
                        <Button   Grid.Row="3" Grid.Column="2" Content="Назначить" Click="RecordHotkey_Click" Tag="NavNext" Margin="6,0,0,0" Height="25"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="К родителю:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="4" Grid.Column="1" x:Name="HkNavParent" Margin="6,2" Height="26"
                                  Background="{DynamicResource PanelBrush2}" Foreground="{DynamicResource TextBrush}"/>
                        <Button   Grid.Row="4" Grid.Column="2" Content="Назначить" Click="RecordHotkey_Click" Tag="NavParent" Margin="6,0,0,0" Background="#FFDDDDDD" Height="25"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="К дочернему:" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="5" Grid.Column="1" x:Name="HkNavChild" Margin="6,2" Height="26"
                                  Background="{DynamicResource PanelBrush2}" Foreground="{DynamicResource TextBrush}"/>
                        <Button   Grid.Row="5" Grid.Column="2" Content="Назначить" Click="RecordHotkey_Click" Tag="NavChild" Margin="6,0,0,0" Height="25"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Width="120" Style="{DynamicResource AccentButton}" Content="Сбросить" Click="Reset_Click"/>
                <Button Width="120" Margin="8,0,0,0" Content="Отмена" Click="Cancel_Click"/>
                <Button Width="120" Margin="8,0,0,0" Style="{DynamicResource AccentButton}" Content="Сохранить" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
<Window x:Class="YellowBlackEditor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Height="720" Width="720" MinHeight="420" MinWidth="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}">
    <Border Margin="10" Padding="14"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="Цвета темы" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border x:Name="AccentRow" CornerRadius="6" Padding="6" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                            MouseLeftButtonDown="AccentRow_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Акцентный цвет" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="AccentBox" Margin="8,0" Height="28"
                                     Style="{DynamicResource FieldBox}"
                                     GotFocus="AccentBox_GotFocus"/>
                            <Rectangle Grid.Column="2" Width="28" Height="28" RadiusX="6" RadiusY="6"
                                       Stroke="{DynamicResource BorderBrush1}" StrokeThickness="1"
                                       x:Name="AccentPreview"/>
                        </Grid>
                    </Border>

                    <Border x:Name="TextRow" CornerRadius="6" Padding="6" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                            MouseLeftButtonDown="TextRow_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Цвет текста" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TextBoxColor" Margin="8,0" Height="28"
                                     Style="{DynamicResource FieldBox}"
                                     GotFocus="TextBoxColor_GotFocus"/>
                            <Rectangle Grid.Column="2" Width="28" Height="28" RadiusX="6" RadiusY="6"
                                       Stroke="{DynamicResource BorderBrush1}" StrokeThickness="1"
                                       x:Name="TextPreview"/>
                        </Grid>
                    </Border>

                    <Border x:Name="PanelRow" CornerRadius="6" Padding="6" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1"
                            MouseLeftButtonDown="PanelRow_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Фон панелей" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="PanelBox" Margin="8,0" Height="28"
                                     Style="{DynamicResource FieldBox}"
                                     GotFocus="PanelBox_GotFocus"/>
                            <Rectangle Grid.Column="2" Width="28" Height="28" RadiusX="6" RadiusY="6"
                                       Stroke="{DynamicResource BorderBrush1}" StrokeThickness="1"
                                       x:Name="PanelPreview"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Готовые цвета" Margin="0,8,0,4"
                               Foreground="{DynamicResource SubTextBrush}"/>
                    <WrapPanel x:Name="QuickAccents" ItemHeight="30" ItemWidth="30"/>

                    <TextBlock Text="Размер шрифта" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Текст заметок" VerticalAlignment="Center" Width="120"/>
                        <ComboBox x:Name="EditorFontBox" Style="{DynamicResource AccentCombo}" Width="90" Height="32" Margin="0"/>
                        <TextBlock Text="Дерево слева" VerticalAlignment="Center" Width="110" Margin="24,0,0,0"/>
                        <ComboBox x:Name="TreeFontBox" Style="{DynamicResource AccentCombo}" Width="90" Height="32" Margin="0"/>
                    </StackPanel>

                    <TextBlock Text="Запуск и напоминания" FontWeight="SemiBold" Margin="0,14,0,8"/>
                    <CheckBox x:Name="TrayCheck" Style="{DynamicResource SettingCheck}">
                        <StackPanel>
                            <TextBlock Text="При закрытии окна оставлять программу в трее"/>
                            <TextBlock Text="Иначе напоминания не придут, пока программа закрыта" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AutostartCheck" Style="{DynamicResource SettingCheck}">
                        <StackPanel>
                            <TextBlock Text="Запускать вместе с Windows"/>
                            <TextBlock Text="Программа стартует свёрнутой в трей" Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="Обмен через общую папку" FontWeight="SemiBold" Margin="0,14,0,8"/>
                    <CheckBox x:Name="SyncCheck" Style="{DynamicResource SettingCheck}">
                        <StackPanel>
                            <TextBlock Text="Обмениваться клиентами через папку"/>
                            <TextBlock Text="Общие: клиенты из раздела «Клиенты» с заметками, точками, доступами и проектами. Напоминания и другие разделы остаются личными. Обмен раз в минуту и при открытии клиента."
                                       Foreground="{DynamicResource SubTextBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="560"/>
                        </StackPanel>
                    </CheckBox>
                    <Grid Margin="30,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SyncFolderBox" Style="{DynamicResource FieldBox}" Tag="X:\Отделы ИТФ\Отдел программирования\ОбменЗ"/>
                        <Button Grid.Column="1" Style="{DynamicResource SecondaryButton}" Height="38" Margin="8,0,0,0" Content="Выбрать" Click="PickSyncFolder_Click"/>
                    </Grid>

                    <TextBlock Text="Горячие клавиши" FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Создать раздел" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="0" Grid.Column="1" x:Name="HkCreateSection" Margin="6,3" Style="{DynamicResource FieldBox}"/>
                        <Button   Grid.Row="0" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="38" Content="Записать" Click="RecordHotkey_Click" Tag="CreateSection" Margin="6,3,0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Создать заметку" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="1" Grid.Column="1" x:Name="HkCreateDocument" Margin="6,3" Style="{DynamicResource FieldBox}"/>
                        <Button   Grid.Row="1" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="38" Content="Записать" Click="RecordHotkey_Click" Tag="CreateDocument" Margin="6,3,0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Перейти к предыдущему" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="2" Grid.Column="1" x:Name="HkNavPrev" Margin="6,3" Style="{DynamicResource FieldBox}"/>
                        <Button   Grid.Row="2" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="38" Content="Записать" Click="RecordHotkey_Click" Tag="NavPrev" Margin="6,3,0,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Перейти к следующему" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="3" Grid.Column="1" x:Name="HkNavNext" Margin="6,3" Style="{DynamicResource FieldBox}"/>
                        <Button   Grid.Row="3" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="38" Content="Записать" Click="RecordHotkey_Click" Tag="NavNext" Margin="6,3,0,3"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Перейти к родительскому" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="4" Grid.Column="1" x:Name="HkNavParent" Margin="6,3" Style="{DynamicResource FieldBox}"/>
                        <Button   Grid.Row="4" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="38" Content="Записать" Click="RecordHotkey_Click" Tag="NavParent" Margin="6,3,0,3"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Перейти к вложенному" VerticalAlignment="Center"/>
                        <TextBox  Grid.Row="5" Grid.Column="1" x:Name="HkNavChild" Margin="6,3" Style="{DynamicResource FieldBox}"/>
                        <Button   Grid.Row="5" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="38" Content="Записать" Click="RecordHotkey_Click" Tag="NavChild" Margin="6,3,0,3"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{DynamicResource SecondaryButton}" Content="Вернуть цвета по умолчанию" Click="Reset_Click"/>
                <Button Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" Content="Отмена" Click="Cancel_Click" IsCancel="True"/>
                <Button Height="36" Margin="8,0,0,0" Style="{DynamicResource AccentButton}" Content="Сохранить" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>